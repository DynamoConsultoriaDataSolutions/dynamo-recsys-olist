# --- Datos (los CSV crudos no se suben: cada quien los descarga con src/data/download_data.py) ---
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Excepción: la tabla de interacciones (~9.5 MB) se versiona para el dashboard publicado
!data/processed/interactions.parquet
*.zip

# --- Modelos y experimentos ---
models/*
!models/.gitkeep
!models/item2item_hibrido.joblib
mlruns/
mlartifacts/
mlflow.db

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Entornos ---
.venv/
venv/
env/
.env
kaggle.json

# --- Editores / SO ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Power BI (archivos temporales) ---
~$*.pbix
*.xlsx
